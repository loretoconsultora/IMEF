# URL del webhook de n8n que recibe los leads del formulario (ver n8n-workflows/imef/README.md)
NEXT_PUBLIC_N8N_IMEF_WEBHOOK=

# Numero de WhatsApp de IMEF, formato lada_pais+numero sin signos (ej. 5215500000000)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL de embed de YouTube/Vimeo para el video de prueba social (opcional, se muestra un placeholder si esta vacio)
NEXT_PUBLIC_VIDEO_EMBED_URL=
