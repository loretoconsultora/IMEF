# URL del webhook de n8n que recibe los leads del formulario (ver n8n-workflows/imef/README.md)
NEXT_PUBLIC_N8N_IMEF_WEBHOOK=

# Numero de WhatsApp de IMEF, formato lada_pais+numero sin signos (ej. 5215500000000).
# Ya tiene un valor por defecto hardcodeado en src/lib/whatsapp.ts (5214426187545);
# solo necesitas esta variable si quieres sobreescribirlo por entorno.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL de embed de YouTube/Vimeo para el video de prueba social (opcional, se muestra un placeholder si esta vacio)
NEXT_PUBLIC_VIDEO_EMBED_URL=

# URL del calendario de Calendly de IMEF (ej. https://calendly.com/imef/visita).
# Sin esta variable, la confirmacion del formulario muestra un mensaje generico
# de "te contactaremos" en vez del boton para elegir horario.
NEXT_PUBLIC_CALENDLY_URL=
