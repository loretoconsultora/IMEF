# URL del webhook de n8n que recibe los leads del formulario (ver n8n-workflows/imef/README.md)
NEXT_PUBLIC_N8N_IMEF_WEBHOOK=

# Numero de WhatsApp de IMEF, formato lada_pais+numero sin signos (ej. 5215500000000).
# Ya tiene un valor por defecto hardcodeado en src/lib/whatsapp.ts (5214426187545);
# solo necesitas esta variable si quieres sobreescribirlo por entorno.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URLs de embed de YouTube/Vimeo de los videos de la landing.
# Ya tienen un valor por defecto hardcodeado en Hero.tsx / VideoSocialProof.tsx;
# solo necesitas estas variables si quieres sobreescribirlas.
NEXT_PUBLIC_HERO_VIDEO_EMBED_URL=
NEXT_PUBLIC_TESTIMONIO_1_EMBED_URL=
NEXT_PUBLIC_TESTIMONIO_2_EMBED_URL=

# URL de Calendly de IMEF para agendar la entrevista en linea. Ya tiene un
# valor por defecto hardcodeado en LeadForm.tsx; solo necesitas esta variable
# si quieres sobreescribirla por entorno.
NEXT_PUBLIC_CALENDLY_ONLINE_URL=

# ID del Pixel de Meta (Facebook/Instagram Ads) para tracking de PageView,
# Contact (clics en WhatsApp) y Lead (registro en el formulario). Sin esta
# variable el Pixel simplemente no se carga (no rompe la landing).
NEXT_PUBLIC_META_PIXEL_ID=
